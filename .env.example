# Public (safe to expose in the browser). Required for live Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional alias if your project uses the newer publishable key name
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. Required for live AML 3:3a critical-incident emails.
RESEND_API_KEY=re_...
SAFETY_ALERT_RECIPIENT=safety@your-domain.se

# Optional. Defaults to onboarding@resend.dev (test only). Use a verified Resend domain in production.
RESEND_FROM=SiteSafety Nordic <alerts@your-domain.se>

# Public app origin used in alert email links. Set this to the Vercel production URL.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional. Shared secret for a Supabase Database Webhook (table: incidents, event: INSERT,
# URL: https://your-app.vercel.app/api/alerts/critical-incident, header x-alert-secret: <this value>).
# The webhook makes critical-incident e-mails independent of the reporter's browser.
ALERT_WEBHOOK_SECRET=change-me

# Optional. Gives every company its own address: <company>.<root domain>.
# Needs a domain you own with a wildcard record (*.your-domain.com) added to the Vercel project.
NEXT_PUBLIC_ROOT_DOMAIN=your-domain.com

# Optional. Cloudflare Turnstile ("are you a person") on the anonymous report form.
# Create a free widget at dash.cloudflare.com; both values are needed. Without them the check is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
